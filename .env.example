# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string (Supabase: Settings → Database → Connection string).
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Auth.js session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Password assigned to all `npx prisma db seed` demo users (one per role).
SEED_USER_PASSWORD="ChangeMe123!"
